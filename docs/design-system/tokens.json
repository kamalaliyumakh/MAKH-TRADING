{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand": {"navy": "#102A43", "blue": "#155EEF", "blueHover": "#004EEB", "teal": "#087F5B"},
    "neutral": {"0": "#FFFFFF", "25": "#F8FAFC", "50": "#F1F5F9", "100": "#E2E8F0", "300": "#94A3B8", "600": "#475569", "700": "#334155", "900": "#0F172A"},
    "semantic": {"info": "#155EEF", "success": "#087F5B", "warning": "#8A4B00", "danger": "#B42318"},
    "semanticSurface": {"info": "#EFF4FF", "success": "#ECFDF3", "warning": "#FFF7E6", "danger": "#FEF3F2"},
    "mode": {"paper": "#155EEF", "paperSurface": "#EFF4FF", "live": "#8A4B00", "liveSurface": "#FFF7E6"},
    "focus": "#7C3AED"
  },
  "font": {
    "family": {"sans": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif", "mono": "IBM Plex Mono, ui-monospace, SFMono-Regular, Consolas, monospace"},
    "sizeRem": {"xs": 0.75, "sm": 0.875, "md": 1, "lg": 1.125, "xl": 1.25, "2xl": 1.5, "3xl": 1.875, "4xl": 2.25},
    "lineHeight": {"tight": 1.25, "normal": 1.5, "relaxed": 1.625},
    "weight": {"regular": 400, "medium": 500, "semibold": 600, "bold": 700}
  },
  "spaceRem": {"0": 0, "1": 0.25, "2": 0.5, "3": 0.75, "4": 1, "5": 1.25, "6": 1.5, "8": 2, "10": 2.5, "12": 3, "16": 4, "20": 5},
  "radiusRem": {"none": 0, "sm": 0.25, "md": 0.5, "lg": 0.75, "pill": 999},
  "borderPx": {"default": 1, "strong": 2, "focus": 3},
  "shadow": {"sm": "0 1px 2px rgba(15, 23, 42, 0.08)", "md": "0 4px 12px rgba(15, 23, 42, 0.12)", "none": "none"},
  "motionMs": {"instant": 0, "fast": 120, "normal": 180, "slow": 240},
  "breakpointPx": {"sm": 480, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1536},
  "containerPx": {"content": 1200, "wide": 1440, "measure": 720},
  "zIndex": {"base": 0, "sticky": 100, "header": 200, "overlay": 800, "modal": 900, "toast": 1000},
  "controlPx": {"minimumTarget": 24, "compact": 36, "default": 44, "comfortable": 48}
}
