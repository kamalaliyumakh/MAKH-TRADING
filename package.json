{
  "name": "makh-trading",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "format": "prettier --write angular.json package.json tsconfig.json pnpm-workspace.yaml .prettierrc 'apps/**/*.{ts,html,scss,json}' 'libs/**/*.{ts,html,scss,json}'",
    "format:check": "prettier --check angular.json package.json tsconfig.json pnpm-workspace.yaml .prettierrc 'apps/**/*.{ts,html,scss,json}' 'libs/**/*.{ts,html,scss,json}'",
    "build:angular": "ng build ui && ng build auth && ng build api-client && ng build realtime && ng build shared && ng build web-public && ng build trading-portal",
    "test:angular": "ng test --watch=false",
    "check:angular-boundaries": "node eng/check-angular-boundaries.mjs",
    "check:devsecops": "node eng/check-devsecops.mjs",
    "scan:secrets": "node --test eng/scan-secret-files.test.mjs eng/discover-secret-files.test.mjs && node eng/scan-secrets.mjs",
    "verify:environments": "node eng/verify-environment-foundation.mjs",
    "verify:foundation-gate": "node eng/verify-foundation-gate.mjs",
    "verify:public-quality": "node eng/verify-public-quality.mjs",
    "verify:public-axe": "node eng/verify-public-axe.mjs",
    "verify:public-lighthouse": "node eng/verify-public-lighthouse.mjs",
    "verify:public-preferences": "node eng/verify-public-preferences.mjs",
    "verify:public-milestone": "node eng/verify-public-milestone.mjs",
    "verify:portal-provenance-gate": "node eng/verify-portal-provenance-gate.mjs",
    "verify:scanner-accessibility": "node eng/verify-scanner-accessibility.mjs",
    "verify:scanner-performance": "node eng/verify-scanner-performance.mjs",
    "verify:scanner-browser-compatibility": "node eng/verify-scanner-browser-compatibility.mjs",
    "verify:journal-accessibility": "node eng/verify-journal-accessibility.mjs",
    "verify:angular": "ng version && ng config cli.packageManager && ng config projects",
    "verify": "pnpm format:check && pnpm verify:angular && pnpm check:angular-boundaries && pnpm check:devsecops && pnpm build:angular && pnpm test:angular",
    "serve:ssr:web-public": "node dist/web-public/server/server.mjs",
    "serve:static:web-public": "node eng/serve-public-static.mjs",
    "serve:static:trading-portal": "node eng/serve-portal-static.mjs"
  },
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-server": "22.1.1",
    "@angular/router": "22.1.1",
    "@angular/ssr": "22.1.3",
    "@microsoft/signalr": "10.0.11",
    "express": "5.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@axe-core/playwright": "4.14.0",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "axe-core": "4.13.0",
    "jsdom": "28.1.0",
    "lighthouse": "13.4.1",
    "ng-packagr": "22.1.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
